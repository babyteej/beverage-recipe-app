# Anthropic API (required for seeding + combination engine)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase (required for commit_ingredients.py and the FastAPI backend)
# Create a project at https://supabase.com, run supabase/schema.sql, then copy these values.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Anthropic model (seeding)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Combination generator — Haiku is much faster; Sonnet gives richer recipes
COMBINATION_MODEL=claude-haiku-4-5

# Seeding script options
SEED_DELAY_SECONDS=1
